#!/bin/bash
# =============================================================================
# Check: the Foundry technical user of the scope is valid
#
# Reads credentials_secret with deployment/scripts/read_credentials (the
# same step the deployments run: the secret must live under the secrets
# prefix of the namespace and hold {"username", "password"}) and runs
# `mfcli authenticate` with it. Sourced in the workflow shell, so the
# credentials it exports (MFCLI_USER, MFCLI_PASSWORD) reach the next checks.
# The password and the token never reach the log or the evidence.
#
# Sourced by the diagnose executor: it returns, never exits. Inputs:
# CREDENTIALS_SECRET, SECRETS_PREFIX, ASSETS_REGION, MFCLI_AUTH_ARGS,
# MFCLI_CMD (build_context and values.yaml).
# =============================================================================

check_credentials_valid() {
	local scripts="${SERVICE_PATH:?SERVICE_PATH is not set}/deployment/scripts"
	local read_log evidence details first_line auth_mode="on-premises"

	print_info "Reading the Foundry credentials from secret ${CREDENTIALS_SECRET:-<credentials_secret>}"
	read_log=$(mktemp)
	# shellcheck source=voltmx-foundry-app/deployment/scripts/read_credentials
	if ! source "$scripts/read_credentials" >"$read_log" 2>&1; then
		print_error "Could not read the Foundry credentials from secret ${CREDENTIALS_SECRET:-<credentials_secret>}"
		sed 's/^/  /' "$read_log"
		print_action "Store the Foundry technical user as {\"username\": ..., \"password\": ...} under ${SECRETS_PREFIX:-voltmx/<namespace>/} and grant the scope role secretsmanager:GetSecretValue on it"
		details=$(jq -nc --arg secret "${CREDENTIALS_SECRET:-}" --arg prefix "${SECRETS_PREFIX:-}" --arg region "${ASSETS_REGION:-us-east-1}" \
			'{credentials_secret: $secret, secrets_prefix: $prefix, region: $region}')
		rm -f "$read_log"
		evidence=$(evidence_json "The secret ${CREDENTIALS_SECRET:-<credentials_secret>} cannot be read or is not a {username, password} JSON" "critical" \
			"$(jq -nc --arg secret "${CREDENTIALS_SECRET:-}" '[$secret]')" "$details" \
			'["Create the secret with {\"username\": ..., \"password\": ...} under the secrets prefix of the namespace", "Grant the scope role secretsmanager:GetSecretValue on the secret"]')
		update_check_result --status "failed" --evidence "$evidence"
		return 1
	fi
	rm -f "$read_log"
	print_success "Secret read: Foundry user $MFCLI_USER"

	# shellcheck source=voltmx-foundry-app/deployment/scripts/mfcli_run
	source "$scripts/mfcli_run"
	[[ "${MFCLI_AUTH_ARGS:-}" == "-t "* ]] && auth_mode="cloud"

	print_info "Authenticating user $MFCLI_USER against Foundry ($auth_mode)"
	if ! MFCLI_RUN_QUIET=1 mfcli_run authenticate; then
		first_line=$(printf '%s\n' "$MFCLI_ERROR" | sed '/^[[:space:]]*$/d' | head -n 1)
		mfcli_explain_error 2>&1 | sed 's/^/  /'
		details=$(jq -nc --arg user "$MFCLI_USER" --arg secret "${CREDENTIALS_SECRET:-}" --arg mode "$auth_mode" \
			--arg error "${first_line:-no error message}" --argjson status "${MFCLI_LAST_STATUS:-1}" \
			'{user: $user, credentials_secret: $secret, auth: $mode, error: $error, exit_status: $status}')
		evidence=$(evidence_json "Foundry rejected the technical user $MFCLI_USER: ${first_line:-no error message}" "critical" \
			"$(jq -nc --arg user "$MFCLI_USER" '[$user]')" "$details" \
			"$(jq -nc --arg user "$MFCLI_USER" --arg secret "${CREDENTIALS_SECRET:-}" \
				'["Unlock the user " + $user + " in the Foundry console and store its current password in the secret " + $secret, "Check that the worker reaches Foundry (the credentials check also fails when Foundry does not answer)"]')")
		update_check_result --status "failed" --evidence "$evidence"
		return 1
	fi

	print_success "User $MFCLI_USER authenticated against Foundry"
	details=$(jq -nc --arg user "$MFCLI_USER" --arg secret "${CREDENTIALS_SECRET:-}" --arg mode "$auth_mode" \
		'{user: $user, credentials_secret: $secret, auth: $mode}')
	evidence=$(evidence_json "The Foundry technical user $MFCLI_USER authenticates ($auth_mode)" "info" "[]" "$details" "[]")
	update_check_result --status "success" --evidence "$evidence"
}

check_credentials_valid
check_credentials_valid_status=$?
unset -f check_credentials_valid
# shellcheck disable=SC2317
return "$check_credentials_valid_status" 2>/dev/null || exit "$check_credentials_valid_status"

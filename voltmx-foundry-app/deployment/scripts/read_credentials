#!/bin/bash
# =============================================================================
# Read the Foundry credentials
#
# Reads CREDENTIALS_SECRET (only under voltmx/ and SECRETS_PREFIX, see validators) from AWS
# Secrets Manager. The secret is {"username": ..., "password": ...}; the
# values are exported as MFCLI_USER and MFCLI_PASSWORD for mfcli_run. They
# live in the session only: nothing is written to disk and the password is
# never printed. Sourced by the workflow: returns 1 on failure, never exits.
# =============================================================================

# shellcheck source=voltmx-foundry-app/deployment/scripts/validators
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/validators"

read_credentials() {
	local secret region username password
	region="${ASSETS_REGION:-us-east-1}"

	echo "🔍 Reading the Foundry credentials..."
	if [ -z "${SECRETS_PREFIX:-}" ]; then
		{
			echo "   ❌ SECRETS_PREFIX is not set: cannot check that credentials_secret belongs to this namespace"
			echo "  🔧 How to fix:"
			echo "    • Run the deployment workflow from the start so build_context resolves the secrets prefix"
		} >&2
		return 1
	fi
	validate_scope_secret_name "${CREDENTIALS_SECRET:-}" "credentials_secret" "${SECRETS_PREFIX}foundry-uat" || return 1
	validate_secret_in_prefix "$CREDENTIALS_SECRET" "$SECRETS_PREFIX" || return 1

	echo "   📡 Reading secret '$CREDENTIALS_SECRET'"
	if ! secret=$(aws secretsmanager get-secret-value --secret-id "$CREDENTIALS_SECRET" \
		--query SecretString --output text --region "$region" 2>/dev/null); then
		{
			echo "   ❌ Could not read secret '$CREDENTIALS_SECRET' from the secrets manager"
			echo "  💡 Possible causes:"
			echo "    • The secret does not exist in region $region"
			echo "    • The agent role has no secretsmanager:GetSecretValue permission on it"
			echo "  🔧 How to fix:"
			echo "    • Create the secret with {\"username\": ..., \"password\": ...} or grant the agent role read access to it"
		} >&2
		return 1
	fi

	username=$(printf '%s' "$secret" | jq -r 'select(type == "object") | .username | select(type == "string" and length > 0)' 2>/dev/null || true)
	password=$(printf '%s' "$secret" | jq -r 'select(type == "object") | .password | select(type == "string" and length > 0)' 2>/dev/null || true)
	if [ -z "$username" ] || [ -z "$password" ]; then
		{
			echo "   ❌ Secret '$CREDENTIALS_SECRET' is not a {\"username\", \"password\"} JSON"
			echo "  💡 Possible causes:"
			echo "    • The secret holds the password alone or uses other field names"
			echo "  🔧 How to fix:"
			echo "    • Store the Foundry technical user as {\"username\": \"<user>\", \"password\": \"<password>\"}"
		} >&2
		return 1
	fi

	MFCLI_USER="$username"
	MFCLI_PASSWORD="$password"
	export MFCLI_USER MFCLI_PASSWORD
	echo "   ✅ Foundry user: $MFCLI_USER"
}

read_credentials
read_credentials_status=$?
unset -f read_credentials
# shellcheck disable=SC2317
return "$read_credentials_status" 2>/dev/null || exit "$read_credentials_status"
